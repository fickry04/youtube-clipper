generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// AUTHENTICATION MODELS (Better Auth)
// =============================================================================

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  projects      Project[]
  jobs          Job[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// =============================================================================
// PROJECT & VIDEO MODELS
// =============================================================================

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  videos Video[]

  @@index([userId])
}

model Video {
  id           String   @id @default(cuid())
  youtubeUrl   String
  youtubeId    String
  title        String?
  description  String?
  thumbnailUrl String?
  duration     Int? // seconds
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assets        VideoAsset[]
  transcript    Transcript?
  viralAnalysis ViralAnalysis?
  jobs          Job[]

  @@index([projectId])
  @@index([youtubeId])
}

model VideoAsset {
  id          String   @id @default(cuid())
  type        String // "source", "clip", "thumbnail"
  storagePath String // relative path within storage
  mimeType    String
  fileSize    BigInt?
  duration    Float? // seconds
  width       Int?
  height      Int?
  videoId     String?
  video       Video?   @relation(fields: [videoId], references: [id], onDelete: SetNull)
  clipId      String?  @unique
  clip        Clip?    @relation(fields: [clipId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([videoId])
}

// =============================================================================
// TRANSCRIPT MODELS
// =============================================================================

model Transcript {
  id           String   @id @default(cuid())
  videoId      String   @unique
  video        Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  languageCode String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  segments TranscriptSegment[]
}

model TranscriptSegment {
  id           String     @id @default(cuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  offset       Float // seconds from video start
  duration     Float // seconds
  text         String
  lang         String?
  order        Int // segment index for ordering

  @@index([transcriptId])
  @@index([transcriptId, offset])
}

// =============================================================================
// VIRAL ANALYSIS & CLIP MODELS
// =============================================================================

model ViralAnalysis {
  id             String   @id @default(cuid())
  videoId        String   @unique
  video          Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  overallSummary String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clips Clip[]
}

model Clip {
  id               String        @id @default(cuid())
  viralAnalysisId  String
  viralAnalysis    ViralAnalysis @relation(fields: [viralAnalysisId], references: [id], onDelete: Cascade)
  rank             Int
  viralScore       Int // 0-100
  startTime        String // "MM:SS"
  endTime          String // "MM:SS"
  startSeconds     Float
  endSeconds       Float
  durationSeconds  Float
  title            String
  hook             String
  summary          String
  whyViral         String
  category         String[] // ViralCategory values
  strengths        String[]
  weaknesses       String[]
  processingStatus String        @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  processingError  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  asset          VideoAsset?
  subtitles      Subtitle[]
  faceDetections FaceDetection[]
  embedding      Embedding?

  @@index([viralAnalysisId])
}

// =============================================================================
// PROCESSING ARTIFACT MODELS
// =============================================================================

model Subtitle {
  id        String   @id @default(cuid())
  clipId    String
  clip      Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  format    String   @default("srt")
  content   String // SRT content
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clipId, format])
  @@index([clipId])
}

model FaceDetection {
  id         String   @id @default(cuid())
  clipId     String
  clip       Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  timestamp  Float // seconds within clip
  x          Float // normalized 0.0-1.0
  y          Float // normalized 0.0-1.0
  width      Float // normalized 0.0-1.0
  height     Float // normalized 0.0-1.0
  confidence Float
  createdAt  DateTime @default(now())

  @@index([clipId])
}

model Embedding {
  id         String   @id @default(cuid())
  clipId     String   @unique
  clip       Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  model      String // embedding model name
  dimensions Int
  // Stored as JSON string until pgvector is installed
  // Once pgvector is available, migrate this to Unsupported("vector(768)")
  vector     String? // JSON array of floats
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// =============================================================================
// JOB QUEUE MODEL
// =============================================================================

model Job {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId     String?
  video       Video?    @relation(fields: [videoId], references: [id], onDelete: SetNull)
  type        String // DOWNLOAD_VIDEO, TRANSCRIPT, VIRAL_ANALYSIS, CREATE_CLIPS, etc.
  status      String    @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED, CANCELLED
  progress    Int       @default(0) // 0-100
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  payload     Json?
  result      Json?
  error       String?
  bullmqId    String? // BullMQ job ID for reference
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([videoId])
  @@index([status])
}
