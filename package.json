{
  "name": "youtube-transcriber",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker": "tsx --tsconfig tsconfig.worker.json workers/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run worker\"",
