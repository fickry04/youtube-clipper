    "@remotion/google-fonts": "^4.0.516",
    "@remotion/player": "^4.0.516",
    "@remotion/renderer": "^4.0.516",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "better-auth": "^1.7.1",
    "bullmq": "^6.1.2",
    "canvas": "^3.2.3",
    "ioredis": "^6.0.0",
    "next": "16.3.1",
    "nodejs-whisper": "^0.3.1",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "^4.0.516",
    "youtube-transcript-plus": "^2.0.1",
    "zod": "^4.4.3"
